# Copy this file to .env.local and fill in your own values.
# .env.local is already gitignored -- never commit real keys.
#
# Both values come from: Supabase Dashboard -> Project Settings -> API
#   VITE_SUPABASE_URL      = "Project URL" (e.g. https://xxxxx.supabase.co)
#   VITE_SUPABASE_ANON_KEY = "anon public" key
#
# Use the anon/public key ONLY. Never put the service_role key here --
# it bypasses Row Level Security and must never reach the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
